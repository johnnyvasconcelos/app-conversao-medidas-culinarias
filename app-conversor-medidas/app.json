{
  "expo": {
    "name": "Conversor de Medidas",
    "slug": "app-conversor-medidas",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF6E8"
    },
    "ios": {
      "supportsTablet": true,
      "usesAdvertisingId": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFF6E8",
        "usesAdvertisingId": true
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "com.google.android.gms.permission.AD_ID",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.johnnym01.appconversormedidas",
      "ads": {
        "config": {
          "usesAdId": true
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-1408168476808382~1352216245",
          "iosAppId": "ca-app-pub-1408168476808382~1352216245"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9e6959cc-b85b-4b76-a0e2-9acf9e1052ff"
      }
    }
  }
}
